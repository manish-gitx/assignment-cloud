{
  "title": "Temp Converter",
  "uid": "temp-converter",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Running version",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "count by (version) (tempconv_build_info)", "legendFormat": "{{version}}", "instant": true}],
      "options": {"textMode": "name", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Success ratio (5m, non 5xx)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "1 - tempconv:error_ratio:rate5m"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2}}
    },
    {
      "type": "stat",
      "title": "p95 latency (5m)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "tempconv:latency_p95:rate5m"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}}
    },
    {
      "type": "stat",
      "title": "Ready pods",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(up{service=\"temp-converter\"})"}]
    },
    {
      "type": "timeseries",
      "title": "Requests per second by status",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (status) (rate(tempconv_requests_total[1m]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(tempconv_request_duration_seconds_bucket[1m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(tempconv_request_duration_seconds_bucket[1m])))", "legendFormat": "p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "Conversions by unit pair",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (from_unit, to_unit) (rate(tempconv_conversions_total[1m]))", "legendFormat": "{{from_unit}} -> {{to_unit}}"}]
    },
    {
      "type": "timeseries",
      "title": "Pod restarts",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (pod) (kube_pod_container_status_restarts_total{container=\"app\"})", "legendFormat": "{{pod}}"}]
    }
  ]
}
